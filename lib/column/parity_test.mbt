///|
/// Build a column the way the lexer does: by walking text.
fn column_of(probe : (String, Bool)) -> @column.Column {
  let (text, half) = probe
  let (_, col) = @column.count_graphemes(text)
  if half {
    col.half_up()
  } else {
    col
  }
}

///|
/// What the reference would have answered for one comparison.
fn expected(code : Int) -> String {
  match code {
    0 => "false"
    1 => "true"
    _ => "incomparable"
  }
}

///|
/// How our four-way answer reads as one of the reference's three codes.
fn actual(order : @column.ColumnOrder, want : @column.ColumnOrder) -> String {
  match order {
    Incomparable => "incomparable"
    _ => if order == want { "true" } else { "false" }
  }
}

///|
test "every comparison agrees with the reference, incomparability included" {
  let n = probes.length()
  for i in 0..<n {
    let c1 = column_of(probes[i])
    for j in 0..<n {
      let c2 = column_of(probes[j])
      let base = (i * n + j) * 3
      let order = c1.cmp(c2)
      let checks : Array[(Int, @column.ColumnOrder)] = [
        (0, Lt),
        (1, Gt),
        (2, Eq),
      ]
      for check in checks {
        let (k, want) = check
        let got = actual(order, want)
        let should = expected(answers[base + k])
        if got != should {
          fail(
            "probe \{i} vs \{j}: \{want.name()} should be \{should}, got \{got}",
          )
        }
      }
    }
  }
}

///|
test "differences agree with the reference" {
  let n = probes.length()
  for i in 0..<n {
    let c1 = column_of(probes[i])
    for j in 0..<n {
      let c2 = column_of(probes[j])
      let want = differences[i * n + j]
      let got = c1.sub(c2)
      if got != want {
        fail("probe \{i} - \{j}: want \{want} half-columns, got \{got}")
      }
    }
  }
}
