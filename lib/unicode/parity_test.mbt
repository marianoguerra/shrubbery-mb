///|
/// Walk a `[code point, expected]` probe table.
fn check_probes(
  name : String,
  probes : FixedArray[Int],
  pred : (Char) -> Bool,
) -> Unit raise {
  for i in 0..<(probes.length() / 2) {
    let cp = probes[i * 2]
    let want = probes[i * 2 + 1] == 1
    if pred(cp.unsafe_to_char()) != want {
      fail("\{name}: U+\{cp} should be \{want}")
    }
  }
}

///|
test "alphabetic agrees with Racket at every range boundary" {
  check_probes("alphabetic", alphabetic_probes, @unicode.is_alphabetic)
}

///|
test "numeric agrees with Racket at every range boundary" {
  check_probes("numeric", numeric_probes, @unicode.is_numeric)
}

///|
test "symbolic agrees with Racket at every range boundary" {
  check_probes("symbolic", symbolic_probes, @unicode.is_symbolic)
}

///|
test "punctuation agrees with Racket at every range boundary" {
  check_probes("punctuation", punctuation_probes, @unicode.is_punctuation)
}

///|
test "whitespace agrees with Racket at every range boundary" {
  check_probes("whitespace", whitespace_probes, @unicode.is_whitespace)
}

///|
test "every emoji sequence is matched at its full length" {
  for probe in emoji_probes {
    let (s, want) = probe
    let got = @unicode.emoji_sequence_at(s, 0)
    if got != want {
      fail("emoji \{s.escape()}: want \{want} code units, got \{got}")
    }
  }
}

///|
test "single-code-point emoji are recognised as such" {
  for probe in one_char_emoji_probes {
    let (s, _) = probe
    if !@unicode.is_one_char_emoji(s.get_char(0).unwrap()) {
      fail("one-char emoji \{s.escape()} not recognised")
    }
  }
}

///|
test "grapheme counts agree with Racket" {
  for probe in grapheme_probes {
    let (s, want) = probe
    let got = @unicode.grapheme_count(s)
    if got != want {
      fail("graphemes of \{s.escape()}: want \{want}, got \{got}")
    }
  }
}
